rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Media files - users can only access their own files
    match /media/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Thumbnails - users can only access their own thumbnails
    match /thumbnails/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Reports - users can only access their own report files
    match /reports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Exports - users can only access their own export files
    match /exports/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Profile pictures - users can only access their own profile pictures
    match /profiles/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default rule - deny access to all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
